<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_move_cutoff.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expense_cutoff_journal_id']/.." position="after">
                <div class="text-muted">
                    Misc
                </div>
                <div class="text-muted">
                    <field name="general_cutoff_journal_id" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
